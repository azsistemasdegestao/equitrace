# Copie para .env.docker e preencha com valores reais
# Este arquivo é commitado no git — não coloque segredos aqui

# Credenciais do container PostgreSQL
POSTGRES_USER=wallet
POSTGRES_PASSWORD=troque_na_producao
POSTGRES_DB=wallet_prod

# URL do banco — hostname deve ser 'db' (nome do serviço docker-compose)
DATABASE_URL="postgresql://wallet:troque_na_producao@db:5432/wallet_prod"

# Segredos Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="gere-um-secret-forte-aqui"
NEXTAUTH_SECRET="gere-um-secret-forte-aqui"
NEXTAUTH_URL="http://seu-ip-ou-dominio:3000"
AUTH_TRUST_HOST=true

# Chave Finnhub
FINNHUB_API_KEY="sua-chave-finnhub-aqui"
